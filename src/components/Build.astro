---
import { layers, services } from '../data/site';
---

<section class="band bd" id="build">
  <div class="shell">
    <p class="eyebrow">What I build</p>

    <div class="bd__head">
      <h2 class="bd__h2">Three stages.<br />One person<br />doing all of them.</h2>
      <p class="lead">
        Most projects get stuck in the gaps between people — the designer who has moved on,
        the developer who left halfway, the person who set it up and can't be reached. There
        are no gaps here, because there's nobody to hand it over to.
      </p>
    </div>

    <ul class="bd__layers">
      {layers.map((l, i) => (
        <li class={`bd__layer plate plate--${l.color} reveal`} data-reveal-delay={i * 90}>
          <p class={`bd__tag bd__tag--${l.color}`}>{l.name}</p>
          <p class="bd__blurb">{l.blurb}</p>
          <ul class="bd__items">
            {l.items.map((item) => <li>{item}</li>)}
          </ul>
        </li>
      ))}
    </ul>

    <h3 class="bd__sub">Ways people usually come to me</h3>
    <ul class="bd__svcs">
      {services.map((s, i) => (
        <li class="bd__svc reveal" data-reveal-delay={(i % 3) * 80}>
          {s.tag && <span class="bd__chip">{s.tag}</span>}
          <h4>{s.title}</h4>
          <p>{s.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .bd__head { display: grid; gap: 1.75rem; margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .bd__h2 { font-size: var(--t-h1); letter-spacing: -0.045em; }

  /* --- the three layers --- */
  .bd__layers { display: grid; gap: 1.9rem; }
  /* Rows: tag / blurb / items. Giving the blurb the flexible row pins the
     dashed divider to the bottom of the card, so all three align even when the
     copy wraps to a different number of lines at some width. */
  .bd__layer {
    padding: 1.9rem 1.7rem;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  .bd__layer:hover { transform: translate3d(-2px, -2px, 0); box-shadow: calc(var(--misreg) + 3px) calc(var(--misreg) + 3px) 0 var(--plate-color); }

  .bd__tag {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.55rem;
    letter-spacing: -0.035em;
    margin-bottom: 0.7rem;
  }
  .bd__tag--orange { color: var(--orange-text); }
  .bd__tag--grape { color: var(--grape-text); }
  .bd__tag--jade { color: var(--jade-text); }

  .bd__blurb { color: var(--ink-soft); font-size: 0.98rem; line-height: 1.6; }
  .bd__items {
    margin-top: 1.3rem;
    padding-top: 1.2rem;
    border-top: 1px dashed color-mix(in srgb, var(--ink) 25%, transparent);
    display: grid;
    gap: 0.5rem;
  }
  .bd__items li {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    display: flex;
    gap: 0.55rem;
  }
  .bd__items li::before { content: '→'; color: var(--ink-faint); flex: none; }

  /* --- services --- */
  .bd__sub {
    font-size: var(--t-h2);
    margin-top: clamp(4rem, 8vw, 6.5rem);
    margin-bottom: 2.5rem;
    }
  .bd__svcs { display: grid; gap: 1px; background: color-mix(in srgb, var(--ink) 22%, transparent); border: var(--edge) solid var(--ink); border-radius: var(--r); overflow: hidden; }
  .bd__svc { background: var(--paper-pale); padding: 1.85rem 1.7rem; position: relative; transition: background 0.25s ease; }
  .bd__svc:hover { background: #fff; }
  .bd__svc h4 {
    font-size: var(--t-h3);
    margin-top: 2.05rem;
    margin-bottom: 0.75rem;
    }
  .bd__svc p { color: var(--ink-soft); font-size: 0.96rem; line-height: 1.65; }
  /* Every card reserves the chip's band (see the h4 offset below) and the chip
     is placed inside it. Headings align across the grid whether or not the card
     is tagged, and nothing overlaps. */
  .bd__chip {
    position: absolute;
    top: 1.85rem;
    left: 1.7rem;
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    background: var(--jade-text);
    color: var(--paper-pale);
    padding: 0.2rem 0.55rem;
    border-radius: 100px;
    white-space: nowrap;
  }

  @media (min-width: 760px) {
    .bd__svcs { grid-template-columns: repeat(2, 1fr); }
  }
  /* Three columns only once each one can hold the copy comfortably. Below this
     the columns get so narrow that the blurbs run to six lines and the item
     lists wrap unevenly, which knocks the dividers out of line. */
  @media (min-width: 820px) {
    .bd__layers { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 1050px) {
    .bd__head { grid-template-columns: 1fr 1fr; gap: 4rem; align-items: end; }
    .bd__svcs { grid-template-columns: repeat(3, 1fr); }
  }
</style>
