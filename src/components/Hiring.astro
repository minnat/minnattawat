---
import { site } from '../data/site';
---

<section class="hr" id="hiring">
  <div class="shell">
    <div class="hr__box">
      <div class="hr__copy">
        <h2 class="hr__h2">If you're hiring rather than building</h2>
        <p class="hr__p">
          Everything above is for people who want something built. If you're hiring instead,
          I'm open to the right permanent role. My CV has the technical detail this page
          leaves out.
        </p>
      </div>
      <div class="hr__act">
        <a class="btn" href={site.cvFile} target="_blank" rel="noopener">
          View my CV
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hr { padding-block: clamp(3rem, 6vw, 4.5rem); background: var(--ink); }

  .hr__box {
    display: grid;
    gap: 1.75rem;
    align-items: center;
    background: var(--grape);
    border: var(--edge) solid var(--paper-pale);
    border-radius: var(--r);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    box-shadow: var(--misreg) var(--misreg) 0 var(--jade);
    color: var(--paper-pale);
  }

  .hr__h2 { font-size: clamp(1.6rem, 3.2vw, 2.4rem); letter-spacing: -0.035em; }
  .hr__p { color: #EDE6FA; margin-top: 0.9rem; max-width: 56ch; line-height: 1.65; }

  .hr__act { display: grid; gap: 0.75rem; justify-items: start; }
  .hr__act .btn { --btn-bg: var(--paper-pale); --btn-fg: var(--ink); --btn-shadow: var(--orange); border-color: var(--paper-pale); }

  @media (min-width: 860px) {
    .hr__box { grid-template-columns: 1fr auto; gap: 3rem; }
    .hr__act { justify-items: end; text-align: right; }
  }
</style>
