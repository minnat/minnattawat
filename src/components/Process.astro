---
import { process } from '../data/site';
---

<section class="band band--deep pr" id="process">
  <div class="shell">
    <p class="eyebrow">How it works</p>

    <div class="pr__head">
      <h2 class="pr__h2">Four steps, and you can stop after any of them.</h2>
      <p class="lead">
        There's no package to choose and no price list to decode, because no two jobs are
        the same. We talk, I work out honestly what it takes, and you decide.
      </p>
    </div>

    <ol class="pr__list">
      {process.map((p, i) => (
        <li class="pr__step reveal" data-reveal-delay={i * 90}>
          <span class="pr__num" aria-hidden="true">{p.step}</span>
          <div class="pr__body">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <aside class="pr__note plate plate--grape">
      <p class="pr__notek mono">On money</p>
      <p>
        I quote a price for the job, not an hourly rate, and you pay in stages as you see
        parts of it working. No monthly fee, no minimum, nothing to cancel. Your domain and
        every account is in your name from day one, not signed over at the end.
      </p>
    </aside>
  </div>
</section>

<style>
  .pr__head { display: grid; gap: 1.5rem; margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .pr__h2 { font-size: var(--t-h1); max-width: 16ch; }

  .pr__list { display: grid; gap: 0; counter-reset: none; margin: 0; padding: 0; list-style: none; }

  .pr__step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
    border-top: var(--edge) solid var(--ink);
    align-items: start;
  }
  .pr__step:last-of-type { border-bottom: var(--edge) solid var(--ink); }

  .pr__num {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--paper-pale);
    background: var(--ink);
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    flex: none;
  }
  .pr__step:nth-child(1) .pr__num { background: var(--orange-text); }
  .pr__step:nth-child(2) .pr__num { background: var(--grape-text); }
  .pr__step:nth-child(3) .pr__num { background: var(--jade-text); }

  .pr__body h3 { font-size: var(--t-h3); margin-bottom: 0.6rem; }
  .pr__body p { color: var(--ink-soft); max-width: 62ch; line-height: 1.68; }

  .pr__note { margin-top: clamp(2.5rem, 5vw, 3.5rem); padding: 1.85rem 1.7rem; max-width: 62ch; }
  .pr__notek { color: var(--grape-text); margin-bottom: 0.7rem; }
  .pr__note p:last-child { color: var(--ink-soft); line-height: 1.68; }

  @media (min-width: 760px) {
    .pr__step { grid-template-columns: 4.5rem 1fr; gap: 2.5rem; }
    .pr__head { grid-template-columns: 1.1fr 0.9fr; gap: 4rem; align-items: end; }
  }
</style>
