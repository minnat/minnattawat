---
import { systems } from '../data/site';

/**
 * The second offering, and a peer of Makes rather than a footnote to it.
 *
 * It reads as a peer through the paired eyebrows ("Half of what I do" / "The
 * other half of what I do") and a card treatment from the same family, not
 * through a louder background. It sits on plain stock between Makes on the
 * deeper peach and the ink of the case study, so the run into the dark band
 * still steps light → deep → dark instead of stacking two dark sections.
 *
 * Same writing rule as everywhere else, with one exception: "AI" is allowed to
 * appear as itself, because the people reading this already use the word.
 * Nothing underneath it is.
 */
---

<section class="band sy" id="systems">
  <div class="shell">
    <p class="eyebrow">The other half of what I do</p>

    <div class="sy__head">
      <h2 class="sy__h2">It doesn't have to be a website.</h2>
      <p class="lead">
        Plenty of businesses don't need a new site. What they need is for the online
        software they already pay for to work together, and for the work still being
        done by hand to start happening on its own.
      </p>
    </div>

    <ul class="sy__grid">
      {systems.map((s, i) => (
        <li class="sy__item reveal" data-reveal-delay={(i % 3) * 80}>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ul>

    <p class="sy__note">
      Everything I build runs in a browser, so this is about the software you already
      use online — your shop, your accounts, your bookings, your inbox, your
      spreadsheets. If you log into it online, I can usually connect it to something
      else or add the part it's missing, without replacing what already works. Software
      that's installed on a computer in the office isn't what I do. Tell me what you use
      and I'll say straight away whether it's something I can help with.
    </p>
  </div>
</section>

<style>
  .sy__head { display: grid; gap: 1.5rem; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .sy__h2 { font-size: var(--t-h2); }

  .sy__grid { display: grid; gap: 1.5rem; }

  /* The Makes card, rotated: same stock, border and hover, but the colour rule
     runs along the top rather than the left. Near enough to read as the same
     family — the two offerings are peers — and different enough that the second
     grid is not mistaken for a continuation of the first. */
  .sy__item {
    background: var(--paper-pale);
    border: var(--edge) solid var(--ink);
    border-radius: var(--r);
    padding: 1.5rem 1.35rem 1.6rem;
    border-top: 6px solid var(--orange);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .sy__item:nth-child(3n + 2) { border-top-color: var(--grape); }
  .sy__item:nth-child(3n + 3) { border-top-color: var(--jade); }
  .sy__item:hover { transform: translate3d(0, -3px, 0); box-shadow: 5px 5px 0 var(--ink); }

  .sy__item h3 { font-size: 1.18rem; margin-bottom: 0.6rem; letter-spacing: -0.025em; }
  .sy__item p { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.65; }

  .sy__note {
    margin-top: clamp(2.25rem, 4vw, 3rem);
    padding-left: 1.25rem;
    /* -text variant: this rule sits on the peach stock now, not the ink. */
    border-left: 4px solid var(--jade-text);
    color: var(--ink-soft);
    max-width: 62ch;
    line-height: 1.65;
  }

  @media (min-width: 700px)  { .sy__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .sy__grid { grid-template-columns: repeat(3, 1fr); } }
</style>
