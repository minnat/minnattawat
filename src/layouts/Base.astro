---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/assets/og.png', Astro.site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#FFF1E0" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Fallback for browsers that ignore SVG favicons (older Safari). -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300..900&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
    />

    {/* Only worth a handshake when analytics is actually configured. */}
    {site.posthogKey && <link rel="preconnect" href={site.posthogHost} crossorigin />}

    {/*
      Two nodes in one graph: the person, and the practice the person runs. The
      page markets services, so describing only a Person leaves search engines
      nothing to attach them to — and this is a one-page site, so there are no
      per-service pages doing that job either.

      This is the one place the site's no-jargon rule does not apply. Nobody
      reads it; search engines match on the standard vocabulary, so it uses the
      terms the schema expects rather than the plain English on the page.
    */}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Person',
            '@id': `https://${site.domain}/#person`,
            name: site.name,
            alternateName: site.shortName,
            jobTitle: site.role,
            url: `https://${site.domain}`,
            address: { '@type': 'PostalAddress', addressLocality: 'Bangkok', addressCountry: 'TH' },
            sameAs: [site.linkedin, site.github, 'https://whereto.party'],
            knowsAbout: [
              'Web development',
              'Online shops',
              'Booking systems',
              'Systems integration',
              'Business process automation',
              'Artificial intelligence',
              'Software development',
            ],
          },
          {
            '@type': 'ProfessionalService',
            '@id': `https://${site.domain}/#practice`,
            name: `${site.shortName} — software, systems and AI automation`,
            url: `https://${site.domain}`,
            image: `https://${site.domain}/assets/og.png`,
            provider: { '@id': `https://${site.domain}/#person` },
            founder: { '@id': `https://${site.domain}/#person` },
            address: { '@type': 'PostalAddress', addressLocality: 'Bangkok', addressCountry: 'TH' },
            areaServed: [
              { '@type': 'Country', name: 'Thailand' },
              { '@type': 'Place', name: 'Remote, worldwide' },
            ],
            hasOfferCatalog: {
              '@type': 'OfferCatalog',
              name: 'What I build',
              itemListElement: [
                {
                  '@type': 'Offer',
                  itemOffered: {
                    '@type': 'Service',
                    name: 'Websites and web applications',
                    description:
                      'Business websites, online shops, booking and enquiry systems, and custom internal tools — designed, built and launched by one person.',
                  },
                },
                {
                  '@type': 'Offer',
                  itemOffered: {
                    '@type': 'Service',
                    name: 'Systems integration',
                    description:
                      'Connecting the cloud and web-based software a business already runs so information moves between systems without anyone retyping it, including custom features built onto an existing web application.',
                  },
                },
                {
                  '@type': 'Offer',
                  itemOffered: {
                    '@type': 'Service',
                    name: 'AI automation',
                    description:
                      'Automating repetitive business processes with AI — reading and sorting incoming messages and documents, extracting structured data, and drafting responses, with validation and human review built in.',
                  },
                },
              ],
            },
          },
        ],
      })}
    />

    <!-- Flip the JS flag before first paint so reveal states never flash. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a href="#main" class="skip">Skip to content</a>
    <slot />

    <script>
      import '../scripts/motion';
      import '../scripts/analytics';
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0.75rem;
        z-index: 10000;
        padding: 0.75rem 1.25rem;
        background: var(--ink);
        color: var(--paper-pale);
        border-radius: 4px;
        font-weight: 700;
      }
      .skip:focus { left: 0.75rem; }
    </style>
  </body>
</html>
