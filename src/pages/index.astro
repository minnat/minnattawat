---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Offer from '../components/Offer.astro';
import Work from '../components/Work.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Hiring from '../components/Hiring.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

/*
 * Offer states both halves of the work — websites, and everything that isn't
 * one — and the proof follows immediately, because whereto.party is the
 * strongest thing on the page and every section between the offer and the
 * evidence is a section the reader might stop at.
 *
 * There used to be a Build section between the two, restating the hero's
 * thesis and listing the offer a second time in other words. It was the
 * longest section on the page and the least load-bearing, so it's gone; the
 * one argument worth keeping out of it — that there are no gaps because
 * there's nobody to hand the work over to — now opens Process.
 */
---
<Base
  title="Min Nattawat — Websites, systems and AI automation"
  description="A website or a shop — or the part in between: two systems that don't talk to each other, or the weekly job still being done by hand. One person, start to finish. Bangkok, working anywhere."
>
  <Header />
  <main id="main">
    <Hero />
    <Offer />
    <Work />
    <Process />
    <About />
    <Hiring />
    <Contact />
  </main>
  <Footer />
</Base>
