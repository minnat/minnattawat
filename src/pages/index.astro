---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Makes from '../components/Makes.astro';
import Systems from '../components/Systems.astro';
import Work from '../components/Work.astro';
import Build from '../components/Build.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Hiring from '../components/Hiring.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

/*
 * Two offerings, presented as peers: Makes is websites, Systems is everything
 * that isn't one. The proof follows immediately, because whereto.party is the
 * strongest thing on the page and every section between the offer and the
 * evidence is a section the reader might stop at.
 *
 * Build and Process then run together as one argument — what the work involves,
 * then how it runs — whichever of the two brought you here.
 */
---
<Base
  title="Min Nattawat — Websites, systems and AI automation"
  description="A website or a shop — or the part in between: two systems that don't talk to each other, or the weekly job still being done by hand. One person, start to finish. Bangkok, working anywhere."
>
  <Header />
  <main id="main">
    <Hero />
    <Makes />
    <Systems />
    <Work />
    <Build />
    <Process />
    <About />
    <Hiring />
    <Contact />
  </main>
  <Footer />
</Base>
