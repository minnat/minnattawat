---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Makes from '../components/Makes.astro';
import Work from '../components/Work.astro';
import Build from '../components/Build.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Hiring from '../components/Hiring.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Min Nattawat — Websites, built start to finish"
  description="A shop, a booking system, somewhere customers find you — or the thing nobody sells off the shelf. One person, from the first idea to the day it goes live. Based in Bangkok, working anywhere."
>
  <Header />
  <main id="main">
    <Hero />
    <Makes />
    <Work />
    <Build />
    <Process />
    <About />
    <Hiring />
    <Contact />
  </main>
  <Footer />
</Base>
